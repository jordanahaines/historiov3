{
  "name": "historiov3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:workflows": "cd lib/workflows && vitest run --config ../../vitest.workflow.config.ts",
    "ingest:pdf": "tsx scripts/ingest-pdf-cli.mts",
    "pipeline:resume": "tsx scripts/resume-pipeline-cli.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check . '!**/*.md'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.mts"
  },
  "packageManager": "pnpm@10.25.0",
  "dependencies": {
    "@heroui/react": "^3.2.7",
    "@heroui/styles": "^3.2.7",
    "@supabase/supabase-js": "^2.119.0",
    "ai": "^7.0.171",
    "drizzle-orm": "^0.45.4",
    "historio-kindle-scribe-notes-parser": "^0.2.0",
    "next": "16.3.4",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.38.0",
    "workflow": "^5.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@workflow/vitest": "^5.0.9",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "^31.0.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
