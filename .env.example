# See CLAUDE.md's "Architecture: Drizzle + Supabase split" section for how the two database URLs are used.

DATABASE_URL=              # Supabase transaction-mode pooler (port 6543) — runtime queries
DATABASE_URL_DIRECT=       # Supabase direct connection (port 5432) — drizzle-kit migrations only
NEXT_PUBLIC_SUPABASE_URL=  # Supabase project URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= # Supabase publishable key (Auth + Storage client only)
SUPABASE_SECRET_KEY=       # Supabase secret key — server-only, for unattended ingestion jobs (Storage writes)
STADIA_MAPS_API_KEY=       # Stadia Maps tile/geocoding key
MAPTILER_API_KEY=          # MapTiler key (satellite basemap); optional
AI_GATEWAY_API_KEY=        # Vercel AI Gateway key — transcription, contextualizer, researchers, insight matching
RESEND_API_KEY=            # Resend API key — fetches inbound email content/attachments
RESEND_WEBHOOK_SECRET=     # Resend (Svix) webhook signing secret for the inbound-email endpoint
INBOUND_EMAIL_DOMAIN=ioestiogra.resend.app # Resend receiving domain; each user's address is <inbound_token>@<this domain>
CONTEXTUALIZER_MODEL=      # Optional — AI Gateway "provider/model" for the Contextualizer; default in lib/ai/model-config.ts
RESEARCHER_MODEL=          # Optional — AI Gateway "provider/model" for the Event/Person Researchers
INSIGHT_MATCHER_MODEL=     # Optional — AI Gateway "provider/model" for the duplicate-insight Matcher
INSIGHT_SYNTHESIZER_MODEL= # Optional — AI Gateway "provider/model" for regenerating merged insight descriptions
